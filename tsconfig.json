{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "declaration": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": ["src", "tests"]
}

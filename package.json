{
    "name": "aldareth",
    "version": "0.1.0-beta.1",
    "description": "Queue and scheduler for Node.js",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "bin": {
        "aldareth": "./dist/cli/index.js"
    },
    "files": [
        "dist",
        "migrations"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepublishOnly": "npm run typecheck && npm test && npm run build",
        "prepare": "npm run build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "croner": "^10.0.1",
        "mysql2": "^3.24.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
